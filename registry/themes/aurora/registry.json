{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "theme-aurora",
      "type": "registry:theme",
      "title": "Tema aurora",
      "description": "Identidade visual \"aurora\": cores em OKLCH (claro e escuro), fontes, raio, densidade, sombra e ícones (lucide). Instale por cima de outro tema com --overwrite para trocar a identidade.",
      "dependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "lucide-react@^1"
      ],
      "files": [
        {
          "path": "icons.ts",
          "type": "registry:lib",
          "target": "@lib/icons.ts"
        }
      ],
      "cssVars": {
        "theme": {
          "font-sans": "'Geist Variable', sans-serif",
          "font-heading": "'Geist Variable', sans-serif",
          "font-mono": "'Geist Mono Variable', monospace",
          "spacing": "0.25rem",
          "shadow-2xs": "0 1px 1px 0 oklch(0 0 0 / 0.04)",
          "shadow-xs": "0 1px 2px 0 oklch(0 0 0 / 0.05)",
          "shadow-sm": "0 1px 3px 0 oklch(0 0 0 / 0.08), 0 1px 2px -1px oklch(0 0 0 / 0.06)",
          "shadow-md": "0 4px 8px -2px oklch(0 0 0 / 0.08), 0 2px 4px -2px oklch(0 0 0 / 0.06)",
          "shadow-lg": "0 10px 16px -4px oklch(0 0 0 / 0.1), 0 4px 6px -4px oklch(0 0 0 / 0.06)",
          "shadow-xl": "0 20px 24px -6px oklch(0 0 0 / 0.1), 0 8px 8px -6px oklch(0 0 0 / 0.05)",
          "shadow-2xl": "0 24px 48px -12px oklch(0 0 0 / 0.2)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-disabled": "var(--disabled)",
          "color-disabled-foreground": "var(--disabled-foreground)"
        },
        "light": {
          "background": "oklch(0.985 0 0)",
          "foreground": "oklch(0.141 0.005 285.823)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.141 0.005 285.823)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.141 0.005 285.823)",
          "primary": "oklch(0.541 0.247 293.009)",
          "primary-foreground": "oklch(1 0 0)",
          "secondary": "oklch(0.967 0.001 286.375)",
          "secondary-foreground": "oklch(0.21 0.006 285.885)",
          "muted": "oklch(0.967 0.001 286.375)",
          "muted-foreground": "oklch(0.442 0.017 285.786)",
          "accent": "oklch(0.967 0.001 286.375)",
          "accent-foreground": "oklch(0.21 0.006 285.885)",
          "destructive": "oklch(0.54 0.22 27)",
          "destructive-foreground": "oklch(1 0 0)",
          "destructive-soft-hover": "oklch(0.54 0.22 27 / 10%)",
          "disabled": "oklch(0.92 0.004 286.32)",
          "disabled-foreground": "oklch(0.442 0.017 285.786)",
          "border": "oklch(0.92 0.004 286.32)",
          "input": "oklch(0.552 0.016 285.938)",
          "ring": "oklch(0.541 0.247 293.009)",
          "sidebar": "oklch(0.967 0.001 286.375)",
          "sidebar-foreground": "oklch(0.21 0.006 285.885)",
          "sidebar-primary": "oklch(0.541 0.247 293.009)",
          "sidebar-primary-foreground": "oklch(1 0 0)",
          "sidebar-accent": "oklch(0.92 0.004 286.32)",
          "sidebar-accent-foreground": "oklch(0.21 0.006 285.885)",
          "sidebar-border": "oklch(0.92 0.004 286.32)",
          "sidebar-ring": "oklch(0.541 0.247 293.009)",
          "chart-1": "oklch(0.62 0.14 293.009)",
          "chart-2": "oklch(0.62 0.14 348.009)",
          "chart-3": "oklch(0.62 0.14 403.009)",
          "chart-4": "oklch(0.62 0.14 493.009)",
          "chart-5": "oklch(0.62 0.14 593.009)",
          "radius": "0.75rem"
        },
        "dark": {
          "background": "oklch(0.141 0.005 285.823)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.21 0.006 285.885)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.21 0.006 285.885)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.72 0.247 293.009)",
          "primary-foreground": "oklch(0.141 0.005 285.823)",
          "secondary": "oklch(0.274 0.006 286.033)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.274 0.006 286.033)",
          "muted-foreground": "oklch(0.705 0.015 286.067)",
          "accent": "oklch(0.274 0.006 286.033)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "destructive-foreground": "oklch(0.141 0.005 285.823)",
          "destructive-soft-hover": "oklch(0.704 0.191 22.216 / 20%)",
          "disabled": "oklch(0.274 0.006 286.033)",
          "disabled-foreground": "oklch(0.705 0.015 286.067)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(0.552 0.016 285.938)",
          "ring": "oklch(0.72 0.247 293.009)",
          "sidebar": "oklch(0.21 0.006 285.885)",
          "sidebar-foreground": "oklch(0.985 0 0)",
          "sidebar-primary": "oklch(0.72 0.247 293.009)",
          "sidebar-primary-foreground": "oklch(0.141 0.005 285.823)",
          "sidebar-accent": "oklch(0.274 0.006 286.033)",
          "sidebar-accent-foreground": "oklch(0.985 0 0)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.72 0.247 293.009)",
          "chart-1": "oklch(0.72 0.14 293.009)",
          "chart-2": "oklch(0.72 0.14 348.009)",
          "chart-3": "oklch(0.72 0.14 403.009)",
          "chart-4": "oklch(0.72 0.14 493.009)",
          "chart-5": "oklch(0.72 0.14 593.009)"
        }
      },
      "css": {
        "@import \"@fontsource-variable/geist\"": {},
        "@import \"@fontsource-variable/geist-mono\"": {},
        "[data-slot]:focus-visible": {
          "outline": "2px solid var(--ring)",
          "outline-offset": "2px",
          "--tw-ring-shadow": "0 0 #0000"
        },
        "[data-slot=\"input-group-control\"]:focus-visible, [data-slot=\"command-input\"]:focus-visible": {
          "outline": "none"
        },
        "[data-slot=\"input-group\"]:has([data-slot=\"input-group-control\"]:focus-visible), [data-slot=\"input-group\"]:has([data-slot=\"command-input\"]:focus-visible)": {
          "outline": "2px solid var(--ring)",
          "outline-offset": "2px",
          "--tw-ring-shadow": "0 0 #0000"
        },
        "[data-slot=\"field-label\"]:has(:focus-visible)": {
          "--tw-ring-shadow": "0 0 #0000"
        },
        "@media (hover: hover)": {
          "[data-slot][class~=\"bg-destructive/10\"]:hover": {
            "background-color": "var(--destructive-soft-hover)",
            "border-color": "var(--destructive)"
          }
        },
        "[data-slot=\"command-input-wrapper\"] [data-slot=\"input-group\"]": {
          "background-color": "var(--muted)",
          "border-color": "var(--border)"
        },
        "[data-slot]:is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"]):not([data-slot=\"breadcrumb-page\"])": {
          "opacity": "1"
        },
        "[data-slot][class~=\"group/button\"]:is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"])": {
          "color": "var(--disabled-foreground)"
        },
        "[data-slot][class~=\"group/button\"]:is([class~=\"bg-primary\"], [class~=\"bg-secondary\"], [class~=\"bg-destructive\"], [class~=\"bg-destructive/10\"]):is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"])": {
          "background-color": "var(--disabled)"
        },
        ":is([data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"select-trigger\"]):is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"])": {
          "background-color": "var(--disabled)",
          "color": "var(--disabled-foreground)"
        },
        "[data-slot=\"input-group\"]:is(:has(:disabled), [data-disabled]:not([data-disabled=\"false\"]))": {
          "background-color": "var(--disabled)",
          "color": "var(--disabled-foreground)",
          "opacity": "1"
        },
        "[data-slot=\"input-group\"]:is(:has(:disabled), [data-disabled]:not([data-disabled=\"false\"])) [data-slot=\"input-group-addon\"]": {
          "color": "var(--disabled-foreground)"
        },
        ":is([data-slot=\"input-group-control\"]):is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"])": {
          "color": "var(--disabled-foreground)"
        },
        ":is([data-slot=\"checkbox\"], [data-slot=\"switch\"], [data-slot=\"radio-group-item\"]):is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"])": {
          "background-color": "var(--disabled)",
          "border-color": "var(--disabled-foreground)",
          "color": "var(--disabled-foreground)"
        },
        "[data-slot=\"switch\"]:is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"]) [data-slot=\"switch-thumb\"]": {
          "background-color": "var(--disabled-foreground)"
        },
        ":is([data-slot=\"select-item\"], [data-slot=\"dropdown-menu-item\"], [data-slot=\"dropdown-menu-checkbox-item\"], [data-slot=\"dropdown-menu-radio-item\"], [data-slot=\"dropdown-menu-sub-trigger\"], [data-slot=\"command-item\"], [data-slot=\"command-input\"], [data-slot=\"tabs-trigger\"], [data-slot=\"sidebar-menu-button\"], [data-slot=\"sidebar-menu-sub-button\"], [data-slot=\"toggle\"], [data-slot=\"toggle-group-item\"]):is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"])": {
          "color": "var(--disabled-foreground)"
        },
        ":is([data-slot=\"select-item\"], [data-slot=\"dropdown-menu-item\"], [data-slot=\"dropdown-menu-checkbox-item\"], [data-slot=\"dropdown-menu-radio-item\"], [data-slot=\"dropdown-menu-sub-trigger\"], [data-slot=\"command-item\"], [data-slot=\"command-input\"], [data-slot=\"tabs-trigger\"], [data-slot=\"sidebar-menu-button\"], [data-slot=\"sidebar-menu-sub-button\"], [data-slot=\"toggle\"], [data-slot=\"toggle-group-item\"]):is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"]) svg": {
          "color": "var(--disabled-foreground)"
        },
        ".peer:is(:disabled, [data-disabled]:not([data-disabled=\"false\"]), [aria-disabled=\"true\"]) ~ [data-slot=\"label\"], [data-disabled=\"true\"] [data-slot=\"label\"], [data-disabled=\"true\"] [data-slot=\"field-label\"]": {
          "color": "var(--disabled-foreground)",
          "opacity": "1"
        },
        "[data-slot][class~=\"group/button\"], [data-slot=\"input\"], [data-slot=\"select-trigger\"], [data-slot=\"toggle\"], [data-slot=\"toggle-group-item\"], [data-slot=\"select-item\"], [data-slot=\"dropdown-menu-item\"], [data-slot=\"dropdown-menu-checkbox-item\"], [data-slot=\"dropdown-menu-radio-item\"], [data-slot=\"dropdown-menu-sub-trigger\"], [data-slot=\"command-item\"], [data-slot=\"tabs-trigger\"], [data-slot=\"sidebar-menu-button\"], [data-slot=\"sidebar-menu-sub-button\"]": {
          "min-height": "revert-layer"
        },
        "[data-slot=\"textarea\"]": {
          "min-height": "revert-layer"
        },
        "[data-slot][class~=\"group/button\"][class~=\"size-6\"], [data-slot][class~=\"group/button\"][class~=\"size-7\"], [data-slot][class~=\"group/button\"][class~=\"size-8\"], [data-slot][class~=\"group/button\"][class~=\"size-9\"], [data-slot=\"toggle\"]": {
          "min-width": "revert-layer"
        },
        "[data-slot=\"checkbox\"]::after": {
          "inset": "revert-layer"
        },
        "[data-slot=\"tabs-list\"]": {
          "height": "revert-layer"
        }
      },
      "docs": "Tema aurora aplicado. Os blocos importam ícones de @/lib/icons (pacote lucide); para trocar de identidade, instale outro theme-<nome> com --overwrite."
    }
  ]
}
