          "accent": "oklch(0.968 0.007 247.896)",
          "accent-foreground": "oklch(0.208 0.042 265.755)",
          "destructive": "oklch(0.54 0.22 27)",
          "destructive-foreground": "oklch(1 0 0)",
          "destructive-soft-hover": "oklch(0.54 0.22 27 / 10%)",
          "disabled": "oklch(0.929 0.013 255.508)",
          "disabled-foreground": "oklch(0.446 0.043 257.281)",
          "border": "oklch(0.929 0.013 255.508)",
          "input": "oklch(0.554 0.046 257.417)",
          "ring": "oklch(0.5 0.119 242.749)",
          "sidebar": "oklch(0.968 0.007 247.896)",
          "sidebar-foreground": "oklch(0.208 0.042 265.755)",
          "sidebar-primary": "oklch(0.5 0.119 242.749)",
          "sidebar-primary-foreground": "oklch(1 0 0)",
          "sidebar-accent": "oklch(0.929 0.013 255.508)",
          "sidebar-accent-foreground": "oklch(0.208 0.042 265.755)",
          "sidebar-border": "oklch(0.929 0.013 255.508)",
          "sidebar-ring": "oklch(0.5 0.119 242.749)",
          "chart-1": "oklch(0.62 0.14 242.749)",
