{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "theme-parque",
      "type": "registry:theme",
      "title": "Tema parque",
      "description": "Identidade visual \"parque\": cores em OKLCH (claro e escuro), fontes, raio, densidade, sombra e ícones (phosphor). Instale por cima de outro tema com --overwrite para trocar a identidade.",
      "dependencies": [
        "@fontsource-variable/fira-code",
        "@fontsource-variable/nunito",
        "@phosphor-icons/react@^2"
      ],
      "files": [
        {
          "path": "icons.ts",
          "type": "registry:lib",
          "target": "@lib/icons.ts"
        }
      ],
      "cssVars": {
        "theme": {
          "font-sans": "'Nunito Variable', sans-serif",
          "font-heading": "'Nunito Variable', sans-serif",
          "font-mono": "'Fira Code Variable', monospace",
          "spacing": "0.25rem",
          "shadow-2xs": "0 1px 1px 0 oklch(0 0 0 / 0.1)",
          "shadow-xs": "0 1px 2px 0 oklch(0 0 0 / 0.125)",
          "shadow-sm": "0 1px 3px 0 oklch(0 0 0 / 0.2), 0 1px 2px -1px oklch(0 0 0 / 0.15)",
          "shadow-md": "0 4px 8px -2px oklch(0 0 0 / 0.2), 0 2px 4px -2px oklch(0 0 0 / 0.15)",
          "shadow-lg": "0 10px 16px -4px oklch(0 0 0 / 0.25), 0 4px 6px -4px oklch(0 0 0 / 0.15)",
          "shadow-xl": "0 20px 24px -6px oklch(0 0 0 / 0.25), 0 8px 8px -6px oklch(0 0 0 / 0.125)",
          "shadow-2xl": "0 24px 48px -12px oklch(0 0 0 / 0.5)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-disabled": "var(--disabled)",
          "color-disabled-foreground": "var(--disabled-foreground)"
        },
        "light": {
          "background": "oklch(0.984 0.003 247.858)",
          "foreground": "oklch(0.129 0.042 264.695)",
          "card": "oklch(1 0 0)",
